# OneSSH 配置模板
# 复制为 .env 放在启动目录,程序启动时自动加载。
# 已 export 的真实环境变量优先,.env 不会覆盖已有值。

# [必填] 64 位十六进制主密钥,可用 openssl rand -hex 32 生成
#ONESSH_MASTER_KEY=

# [必填] WebUI 管理员密码
#ONESSH_ADMIN_PASSWORD=

# HTTP 监听地址(默认 :8866)
#ONESSH_LISTEN=:8866

# 对外访问来源,如 https://ssh.example.com;生产 OAuth 部署应显式设置
#ONESSH_PUBLIC_URL=

# SQLite 与 artifact 数据目录(原生二进制需指向当前用户可写目录,容器内使用 /data)
#ONESSH_DATA_DIR=/data

# 监控轮询秒数,设为 0 关闭(默认 60)
#ONESSH_POLL_INTERVAL=60

# 是否为全部工具发布 MCP Apps 交互卡片:on / off(默认 on)
#ONESSH_MCP_APPS=on

# 临时搜索 helper:auto / off(默认 auto)
#ONESSH_SEARCH_HELPER=auto

# 逗号分隔的工具组名,列出的组不注册为 MCP 工具;未知组名启动即报错
#ONESSH_DISABLED_TOOLS=

# OpenAI 兼容 embedding API,三项同时配置才启用记忆召回
#ONESSH_EMBEDDING_API_URL=
#ONESSH_EMBEDDING_API_KEY=
#ONESSH_EMBEDDING_MODEL=
