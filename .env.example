# OneSSH 配置模板
# 复制为 .env 放在启动目录或 onessh.exe 同目录,程序启动时自动加载。
# 查找顺序: ONESSH_ENV_FILE 指定的文件 > 启动目录/.env > onessh.exe 同目录/.env。
# 已 export 的真实环境变量优先,.env 不会覆盖已有值。
# Windows 快捷方式/计划任务可用 ONESSH_ENV_FILE 指定 .env 的绝对路径。
# 支持 UTF-8,以及带 BOM 的 UTF-8/UTF-16 文本。

# [必填] 64 位十六进制主密钥,可用 openssl rand -hex 32 生成
#ONESSH_MASTER_KEY=

# [必填] WebUI 管理员密码
#ONESSH_ADMIN_PASSWORD=

# HTTP 监听地址(默认 :8866)
#ONESSH_LISTEN=:8866

# 对外访问来源,如 https://ssh.example.com;生产 OAuth 部署应显式设置
#ONESSH_PUBLIC_URL=

# SQLite 与 artifact 数据目录(原生二进制需指向当前用户可写目录,容器内使用 /data)
#ONESSH_DATA_DIR=/data

# 监控轮询秒数,设为 0 关闭(默认 60)
#ONESSH_POLL_INTERVAL=60

# 是否为全部工具发布 MCP Apps 交互卡片:on / off(默认 on)
#ONESSH_MCP_APPS=on

# 临时搜索 helper:auto / off(默认 auto)
#ONESSH_SEARCH_HELPER=auto

# 逗号分隔的工具组名,列出的组不注册为 MCP 工具;未知组名启动即报错
#ONESSH_DISABLED_TOOLS=

# OpenAI 兼容 embedding API,三项同时配置才启用记忆召回
#ONESSH_EMBEDDING_API_URL=
#ONESSH_EMBEDDING_API_KEY=
#ONESSH_EMBEDDING_MODEL=

# ── 飞书登录(可选)──────────────────────────────────────────
# 在 https://open.feishu.cn/app 创建企业自建应用后填入;
# 安全设置里的重定向 URL 需添加 https://<域名>/api/v1/auth/feishu/callback
# 两项都不配置时飞书登录入口不显示,行为与单用户版一致
# 启用时还需取消上方 ONESSH_PUBLIC_URL 的注释(回调地址由此拼接)

# 飞书自建应用凭据,两项必须同时配置
#ONESSH_FEISHU_APP_ID=
#ONESSH_FEISHU_APP_SECRET=
